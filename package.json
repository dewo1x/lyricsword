{
  "name": "wordlight",
  "version": "1.0.0",
  "description": "Fullscreen word-by-word lyrics overlay that lives in the Windows system tray",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.wordlight.desktop",
    "productName": "Wordlight",
    "files": [
      "main.js",
      "preload.js",
      "overlay.html",
      "overlay.js",
      "settings.html",
      "settings.js",
      "renderer.js",
      "renderer.css",
      "smtc.ps1",
      "assets/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}